# High-bandwidth / bulk-transfer traffic
# Intended outbound: a cheap / high-bandwidth / low-multiplier node group.
#
# Most rules target payload-transfer hosts. PikPak is intentionally an
# exception: route its site, API and downloads through the same policy group.

# Docker
DOMAIN,registry-1.docker.io
DOMAIN,production.cloudfront.docker.com
DOMAIN,production.cloudflare.docker.com

# Hugging Face
DOMAIN-SUFFIX,hf.co
DOMAIN,cdn-lfs.huggingface.co

# GitHub large payloads
DOMAIN,release-assets.githubusercontent.com
DOMAIN,objects.githubusercontent.com
DOMAIN,objects-origin.githubusercontent.com
DOMAIN,github-releases.githubusercontent.com
DOMAIN,github-registry-files.githubusercontent.com

# GitHub LFS
DOMAIN,github-cloud.githubusercontent.com
DOMAIN,github-cloud.s3.amazonaws.com

# GitHub Packages / GHCR
DOMAIN,ghcr.io
DOMAIN,pkg-containers.githubusercontent.com
DOMAIN-SUFFIX,pkg.github.com

# Ollama model blobs
DOMAIN,registry.ollama.ai

# Python package payloads
DOMAIN,files.pythonhosted.org

# npm packages
DOMAIN,registry.npmjs.org

# PikPak — all known service domains and download infrastructure
# Main domain list: https://github.com/v2fly/domain-list-community/blob/master/data/pikpak
DOMAIN-SUFFIX,mypikpak.com
DOMAIN-SUFFIX,mypikpak.net
DOMAIN-SUFFIX,pickpackapp.com
DOMAIN-SUFFIX,pikpak.io
DOMAIN-SUFFIX,pikpak.me
DOMAIN-SUFFIX,pikpakdrive.com

# Supplementary hosts from blackmatrix7/ios_rule_script PikPak rules
# Match specific sandai.net service hosts, not the entire shared parent domain.
DOMAIN-KEYWORD,mypikpak
DOMAIN-SUFFIX,dlandroid.rcv.sandai.net
DOMAIN-SUFFIX,hub5idx.v6.shub.sandai.net
DOMAIN-SUFFIX,hub5pn.wap.sandai.net
DOMAIN-SUFFIX,hub5pnc.sandai.net
DOMAIN-SUFFIX,hub5pr.v6.phub.sandai.net
DOMAIN-SUFFIX,hubciddata.sandai.net

# Community-observed PikPak file-download CDN hostname fragments
DOMAIN-KEYWORD,dl-a10b-
DOMAIN-KEYWORD,dl-z01a-
DOMAIN-KEYWORD,dl-b07-
